{
  "schemaVersion": "chart2kro.io/report/v1",
  "chart": {
    "name": "with-subchart",
    "version": "1.0.0",
    "source": "../../testdata/charts/with-subchart"
  },
  "kind": "WithSubchart",
  "group": "kro.run",
  "apiVersion": "v1alpha1",
  "kubeVersion": "1.37",
  "kroVersion": "v0.9.4",
  "witnesses": 10,
  "summary": {
    "exposed": 3,
    "frozen": 0,
    "failed": 0,
    "unused": 1
  },
  "values": [
    {
      "path": "backend.enabled",
      "outcome": "exposed",
      "kind": "conditional",
      "type": "boolean",
      "default": true
    },
    {
      "path": "backend.global",
      "outcome": "unused"
    },
    {
      "path": "backend.name",
      "outcome": "exposed",
      "kind": "reference",
      "type": "string",
      "default": "api",
      "targets": [
        "configMapBackend.data.name"
      ]
    },
    {
      "path": "frontend.name",
      "outcome": "exposed",
      "kind": "reference",
      "type": "string",
      "default": "web",
      "targets": [
        "configMapFrontend.data.name"
      ]
    }
  ],
  "resources": [
    {
      "id": "configMapBackend",
      "kind": "ConfigMap",
      "source": "with-subchart/charts/backend/templates/backend.yaml",
      "includeWhen": [
        "${schema.spec.backend.enabled}"
      ]
    },
    {
      "id": "configMapFrontend",
      "kind": "ConfigMap",
      "source": "with-subchart/templates/frontend.yaml"
    }
  ]
}
